rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Avatares e capas de livro. Sem autenticação: validamos tipo e tamanho.
    match /avatares/{arquivo} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /capas/{arquivo} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
