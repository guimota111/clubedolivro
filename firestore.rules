rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfis dos membros. Sem autenticação, então validamos apenas o formato.
    // `cor` é a cor da barra de progresso do membro, sempre em '#rrggbb'.
    function corValida(dados) {
      return !('cor' in dados.keys())
             || (dados.cor is string && dados.cor.matches('^#[0-9a-fA-F]{6}$'));
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.nome is string
                    && request.resource.data.nome.size() > 0
                    && request.resource.data.nome.size() < 60
                    && request.resource.data.avatarUrl is string
                    && corValida(request.resource.data);
      allow update: if request.resource.data.nome is string
                    && request.resource.data.nome.size() > 0
                    && request.resource.data.nome.size() < 60
                    && corValida(request.resource.data);
    }

    // Livro atual do clube. Qualquer membro pode cadastrar/encerrar.
    match /livroAtual/{livroId} {
      allow read: if true;
      allow write: if request.resource.data.titulo is string
                   && request.resource.data.titulo.size() > 0;
      allow delete: if true;
    }

    // Progresso de leitura em porcentagem (0-100). ID composto userId_livroId.
    // `historico` é a trilha de marcações {pct, em} usada para descobrir o que
    // foi lido nas últimas 24 h; fica limitada para não inchar o documento.
    match /progresso/{progressoId} {
      allow read: if true;
      allow write: if request.resource.data.porcentagem is number
                   && request.resource.data.porcentagem >= 0
                   && request.resource.data.porcentagem <= 100
                   && (!('historico' in request.resource.data.keys())
                       || (request.resource.data.historico is list
                           && request.resource.data.historico.size() <= 60));
    }

    // Resenhas (uma por membro por livro). A regra de "só quem terminou lê"
    // é aplicada no cliente — como todo o app, que é aberto e sem senha.
    match /resenhas/{resenhaId} {
      allow read: if true;
      allow write: if request.resource.data.texto is string
                   && request.resource.data.texto.size() > 0
                   && request.resource.data.texto.size() < 5000
                   && request.resource.data.livroId is string
                   && request.resource.data.userId is string;
    }

    // Notas parciais com desbloqueio por página/porcentagem.
    // O texto pode vir VAZIO quando há reação: uma nota pode ser só o emoji,
    // dizendo o que a pessoa sentiu naquele ponto do livro. O que não se
    // aceita é a nota sem texto e sem reação — aí não sobra nada.
    match /notas/{notaId} {
      allow read: if true;
      allow create, update: if request.resource.data.texto is string
                    && request.resource.data.texto.size() < 5000
                    && request.resource.data.emoji is string
                    && (request.resource.data.texto.size() > 0
                        || request.resource.data.emoji.size() > 0)
                    && request.resource.data.livroId is string
                    && request.resource.data.desbloqueioPct is number
                    && request.resource.data.desbloqueioPct >= 0
                    && request.resource.data.desbloqueioPct <= 100;
      allow delete: if true;
    }

    // Comentários em resenhas e notas parciais.
    match /comentarios/{comentarioId} {
      allow read: if true;
      allow create: if request.resource.data.texto is string
                    && request.resource.data.texto.size() > 0
                    && request.resource.data.texto.size() < 2000
                    && request.resource.data.alvoId is string
                    && request.resource.data.userId is string
                    && request.resource.data.alvoTipo in ['resenha', 'nota'];
      allow delete: if true;
    }

    // Mural de recados. Criação apenas; sem edição/exclusão por enquanto.
    match /mural/{mensagemId} {
      allow read: if true;
      allow create: if request.resource.data.texto is string
                    && request.resource.data.texto.size() > 0
                    && request.resource.data.texto.size() < 1000;
    }

    // Histórico de livros encerrados.
    match /historicoLivros/{livroId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
